  {
    "guid": "63ba5fcd-c8ce-421a-83e8-ba0b11030d53",
    "name": "Xtream Library",
    "description": "Sync Xtream VOD and Series content to native Jellyfin libraries via STRM files for universal client compatibility.",
    "overview": "Creates STRM files from Xtream content for native library integration - works with all clients including Swiftfin.",
    "owner": "firestaerter3",
    "category": "General",
    "versions": [
      {
        "version": "1.34.0.0",
        "changelog": "Preserve full EPG metadata from upstream XMLTV (fixes #42): the plugin previously generated XMLTV from Xtream's JSON endpoint which only exposes title and description. It now passes the upstream xmltv.php through verbatim, preserving categories, ratings, credits, icons, dates, and star-ratings. Jellyfin can again categorize Live TV programs by genre. Falls back to the old JSON-based fetch if the upstream XMLTV is unavailable.",
        "targetAbi": "10.11.0.0",
        "sourceUrl": "https://github.com/firestaerter3/Jellyfin-Xtream-Library/releases/download/v1.34.0.0/jellyfin-xtream-library_1.34.0.0.zip",
        "checksum": "3bf4c69e7815c276a484bd1a22e860a9",
        "timestamp": "2026-05-20T22:00:00Z"
      },
      {
        "version": "1.33.3.0",
        "changelog": "Fix overlapping plugin GUID (#43): the boilerplate placeholder GUID a1b2c3d4-e5f6-7890-abcd-ef1234567890 was shared with three unrelated Jellyfin plugins. Replaced with a freshly-generated random GUID. NOTE: existing installs are treated as a different plugin after upgrade — uninstall the old 'Xtream Library' entry from Jellyfin and reinstall to pick up this version. Plugin configuration is preserved across the reinstall. This release also rolls up multi-provider support (v1.32.0.0), per-channel Live TV selection (v1.33.0.0), and Live TV / legacy-config migration fixes (v1.33.1.0, v1.33.2.0) from the beta channel.",
        "targetAbi": "10.11.0.0",
        "sourceUrl": "https://github.com/firestaerter3/Jellyfin-Xtream-Library/releases/download/v1.33.3.0/jellyfin-xtream-library_1.33.3.0.zip",
        "checksum": "26659da035d6d3d879787b60d7e2520e",
        "timestamp": "2026-05-20T00:00:00Z"
      }
    ]
  },
